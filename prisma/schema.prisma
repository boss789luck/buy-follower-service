generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String
  balance   Float    @default(0)
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  deposits  Deposit[]
}

model Service {
  id             Int      @id @default(autoincrement()) // Our internal ID
  originalId     Int
  provider       String   @default("PANELSOCIAL")
  name           String
  originalPrice  Float    // Original rate per 1000
  price          Float    // Our rate per 1000 (x2)
  min            Int
  max            Int
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  serviceId        Int
  link             String
  quantity         Int
  charge           Float
  status           String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELED
  providerOrderId  String?  // ID returned by panelsocial.club after placing the order
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
  service          Service  @relation(fields: [serviceId], references: [id])
}

model AdminConfig {
  id                 String   @id @default("default")
  coveredUserBalance Float    @default(0)
  globalMarkup       Float    @default(1.5) // 1.5 = +50% profit
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model Deposit {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  slipUrl   String   
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model ServiceUpdate {
  id          String   @id @default(cuid())
  serviceId   Int?
  serviceName String
  type        String   // "NEW", "PRICE_UP", "PRICE_DOWN", "DISABLED"
  oldPrice    Float?
  newPrice    Float?
  createdAt   DateTime @default(now())
}
